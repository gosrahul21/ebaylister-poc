{
  "manifest_version": 3,
  "name": "Product Lister POC — Amazon Details Saver",
  "version": "1.0.0",
  "description": "Extracts and saves full Amazon product details, images, features, description, and specs.",
  "permissions": [
    "debugger",
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Amazon Product Lister"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.com/*",
        "*://amazon.com/*",
        "*://*.amazon.in/*",
        "*://amazon.in/*",
        "*://*.amazon.co.uk/*",
        "*://amazon.co.uk/*",
        "*://*.amazon.de/*",
        "*://amazon.de/*",
        "*://*.amazon.ca/*",
        "*://amazon.ca/*",
        "*://*.amazon.fr/*",
        "*://amazon.fr/*",
        "*://*.amazon.es/*",
        "*://amazon.es/*",
        "*://*.amazon.it/*",
        "*://amazon.it/*",
        "*://*.amazon.co.jp/*",
        "*://amazon.co.jp/*",
        "*://*.amazon.com.au/*",
        "*://amazon.com.au/*",
        "*://*.amazon.com.mx/*",
        "*://amazon.com.mx/*",
        "*://*.amazon.sg/*",
        "*://amazon.sg/*",
        "*://*.amazon.ae/*",
        "*://amazon.ae/*",
        "*://*.amazon.nl/*",
        "*://amazon.nl/*",
        "*://*.amazon.se/*",
        "*://amazon.se/*",
        "*://*.amazon.pl/*",
        "*://amazon.pl/*",
        "*://*.amazon.com.br/*",
        "*://amazon.com.br/*",
        "*://*.amazon.com.tr/*",
        "*://amazon.com.tr/*",
        "*://*.amazon.sa/*",
        "*://amazon.sa/*",
        "*://*.amazon.eg/*",
        "*://amazon.eg/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
